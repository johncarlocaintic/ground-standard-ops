    UseAI true
    Title "Route By Enrollee Type"
    __dynamicVariables
    Description "Based on the contact's answer about who the class is for: {{nodes.n06_whofor_ask.result[0]}}"
    AiCases {
        _ {
            id "case_adult_only"
            CaseName "Just the adult contact, for themselves"
        }
        _ {
            id "case_kid_only"
            CaseName "Just the kid or kids, adult is inquiring on their behalf"
        }
        _ {
            id "case_both"
            CaseName "Both the adult and their kid or kids together"
        }
    }
    AiCases:0 handle="n08_tag_adult"
    AiCases:1 handle="n09_tag_youth"
    AiCases:2 handle="n10_tag_both"
    __position -1000.0 0.0
}

