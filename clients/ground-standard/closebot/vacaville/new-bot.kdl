Statement id="n80_reminders" {
    Attachment ""
    MoveOn true
    UseAI true
    Title "Reminders"
    __dynamicVariables
    Statement "Give general reminders to {{contact.first_name}} about the academy rules (rashguard or fitted shirt and pocketless shorts, water, shoes off on mats, arrive a few minutes early). Ask if they have any questions before wrapping up."
    Next handle="n81_openqa"
    __position 8000.0 0.0
}

Conversation id="n81_openqa" {
    ExtraPrompt "Answer any remaining questions the contact has about the academy, classes, what to expect at the trial, coach Nick, the facility, the CLA methodology, or anything else from the knowledge library. Never quote specific pricing figures — redirect pricing questions per the pricing response policy. When the conversation naturally ends, wrap up warmly."
    __dynamicVariables
    Next handle="EOC"
    __position 8300.0 0.0
}

ScenarioCustom id="n90_scenario_signup" {
    AllowReEntry ""
    Priority 50
    Threshold 7
    Description "Contact shows clear intent to sign up or book a class (e.g. gives their name, DOB, says they want to enroll, or asks to schedule) before the bot has reached the Who Is This For step."
    Title "Sign Up Interrupt"
    __dynamicVariables
    Next handle="n06_whofor_ask"
    __position -2500.0 600.0
}

