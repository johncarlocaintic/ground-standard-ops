# Root .env — agency platform accounts only
# Get real values from JC out-of-band. Never commit this file with values filled in.

# Retell AI (voice agents)
RETELL_API_KEY=

# OpenAI (eval / KB drafting / GPT-based test agents)
OPENAI_API_KEY=

# n8n cloud
N8N_API_KEY=
N8N_BASE_URL=

# Google (Sheets / Calendar / Drive — service account or OAuth)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_PROJECT_ID=
